// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DEVELOPER
}

enum ProjectRole {
  LEADER
  DEVELOPER
  OPERATOR
  VIEWER
}

model CustomRole {
  id                  Int      @id @default(autoincrement())
  name                String   @unique
  permissions         String[] // e.g. ["project:read", "logs:read"]
  assignableByManager Boolean  @default(false)
  ownerId             Int?     // Admin owner who created this role
  owner               User?    @relation("AdminCustomRoles", fields: [ownerId], references: [id])
  users               User[]
  createdAt           DateTime @default(now())
}

model User {
  id                Int             @id @default(autoincrement())
  email             String          @unique
  password          String
  name              String?
  role              Role            @default(DEVELOPER)
  parentId          Int?            // Parent Admin account (Null if Super Admin or Admin itself)
  parent            User?           @relation("UserSubAccounts", fields: [parentId], references: [id])
  children          User[]          @relation("UserSubAccounts")
  customRoleId      Int?
  customRole        CustomRole?     @relation(fields: [customRoleId], references: [id])
  ownedCustomRoles  CustomRole[]    @relation("AdminCustomRoles")
  memberships       ProjectMember[]
  projects          Project[]
  
  // Resource Quotas (Only meaningful for Admin accounts)
  maxRam            Int             @default(1024)  // RAM limit in MB (default 1GB)
  maxDisk           Int             @default(5)     // Disk limit in GB (default 5GB)
  maxProjects       Int             @default(3)     // Max allowed projects
  maxDatabases      Int             @default(2)     // Max allowed databases
  
  createdAt         DateTime        @default(now())
}

model Project {
  id             Int                @id @default(autoincrement())
  name           String
  containerId    String?
  status         String             @default("stopped")
  ramLimit       Int                @default(256)
  cpuLimit       Float              @default(1)
  hostPort       Int?
  subdomain      String             @unique
  customDomain   String?            @unique
  sslStatus      String             @default("none")
  sslExpiry      DateTime?
  // Git Deploy
  gitRepo        String?
  deployBranch   String?            @default("main")
  gitToken       String?
  deployStatus   String?            @default("idle") // idle, deploying, success, failed
  lastDeployedAt DateTime?
  restartPolicy       String             @default("on-failure") // no, on-failure, always
  autoScale           Boolean            @default(false)
  notificationsEnabled Boolean           @default(true)
  volumeMapping       String?            @default("/app/storage")
  slackWebhook        String?
  alertInterval       Int                @default(5)
  userId              Int
  user           User               @relation(fields: [userId], references: [id])
  members        ProjectMember[]
  databases      DatabaseInstance[]
  envVariables   EnvVariable[]
  deployments    DeploymentLog[]
  activityLogs   ActivityLog[]
  stats          ProjectStat[]
  createdAt      DateTime           @default(now())
}

model ProjectMember {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   Int
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role        ProjectRole @default(VIEWER)
  permissions String[]    // backup permissions
  createdAt   DateTime    @default(now())

  @@unique([userId, projectId])
}

model EnvVariable {
  id        Int      @id @default(autoincrement())
  key       String
  value     String
  isSecret  Boolean  @default(false)
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model DeploymentLog {
  id           Int      @id @default(autoincrement())
  projectId    Int
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trigger      String   @default("manual") // manual, git-push
  status       String   @default("pending") // pending, running, success, failed
  gitCommit    String?
  gitMessage   String?
  duration     Int?     // seconds
  log          String?  @db.Text
  createdAt    DateTime @default(now())
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String   // START, STOP, RESTART, UPDATE_RESOURCES, CLONE, DEPLOY
  message   String
  createdAt DateTime @default(now())
}

model ProjectStat {
  id         Int      @id @default(autoincrement())
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cpuUsage   Float    // percentage 0-100
  ramUsage   Float    // MB
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([createdAt])
}

model DatabaseInstance {
  id               Int      @id @default(autoincrement())
  name             String
  type             String
  status           String   @default("provisioning")
  connectionString String?
  projectId        Int
  project          Project               @relation(fields: [projectId], references: [id])
  createdAt        DateTime              @default(now())
  activityLogs     DatabaseActivityLog[]
}

model DatabaseActivityLog {
  id         Int              @id @default(autoincrement())
  databaseId Int
  database   DatabaseInstance @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  action     String           // IMPORT, EXPORT, CHANGE_PASSWORD
  filename   String?
  status     String           // SUCCESS, FAILED
  message    String?          @db.Text
  createdAt  DateTime         @default(now())
}
